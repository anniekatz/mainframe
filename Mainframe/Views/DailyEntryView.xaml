<UserControl x:Class="Mainframe.Views.DailyEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BgBase}">
    <DockPanel Margin="16">
        <!-- header -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="DATE" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                           FontFamily="Consolas" Margin="0,0,10,0"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate}"
                            Width="160" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DAILY TOTAL" FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="Consolas" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DailyTotalHours, StringFormat={}{0:F2} hrs}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- column headers -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}"
                Padding="8,8" CornerRadius="4" Margin="0,0,0,4"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="CHARGE CODE" FontWeight="SemiBold"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           FontFamily="Consolas"/>
                <TextBlock Grid.Column="1" Text="PROJECT" FontWeight="SemiBold"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           FontFamily="Consolas"/>
                <TextBlock Grid.Column="2" Text="TASK" FontWeight="SemiBold"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           FontFamily="Consolas"/>
                <TextBlock Grid.Column="3" Text="SUBTASK" FontWeight="SemiBold"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           FontFamily="Consolas"/>
                <TextBlock Grid.Column="4" Text="HOURS" FontWeight="SemiBold"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           FontFamily="Consolas" TextAlignment="Right" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="5" Text="NOTES" FontWeight="SemiBold"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           FontFamily="Consolas"/>
            </Grid>
        </Border>

        <!-- foot -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding DailyStatusMessage}"
                           VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}"
                           FontStyle="Italic" FontFamily="Consolas" FontSize="12"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="+ ADD ENTRY" Command="{Binding AddDailyEntryCommand}"
                            Margin="0,0,8,0" Padding="16,8" Background="{StaticResource BgElevated}"/>
                    <Button Content="SAVE" Command="{Binding SaveDailyCommand}"
                            Padding="24,8" Background="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- entries as rows -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DailyEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="0,0,0,1" Padding="4,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableChargeCodes}"
                                          SelectedItem="{Binding SelectedChargeCode}"
                                          Margin="2" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableProjects}"
                                          SelectedItem="{Binding SelectedProject}"
                                          Margin="2" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="2"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="Name"
                                          ItemsSource="{Binding AvailableTasks}"
                                          SelectedItem="{Binding SelectedTask}"
                                          LostFocus="TaskComboBox_LostFocus"
                                          Margin="2" VerticalAlignment="Center"/>

                                <ComboBox Grid.Column="3"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="Name"
                                          ItemsSource="{Binding AvailableSubtasks}"
                                          SelectedItem="{Binding SelectedSubtask}"
                                          LostFocus="SubtaskComboBox_LostFocus"
                                          Margin="2" VerticalAlignment="Center"/>

                                <TextBox Grid.Column="4"
                                         Text="{Binding Hours, StringFormat=F2}"
                                         Margin="2" VerticalAlignment="Center"
                                         TextAlignment="Right" Padding="4,4"
                                         GotKeyboardFocus="HoursTextBox_GotKeyboardFocus"
                                         PreviewMouseLeftButtonDown="HoursTextBox_PreviewMouseLeftButtonDown"/>

                                <TextBox Grid.Column="5"
                                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="2" VerticalAlignment="Center" Padding="4,4"/>

                                <Button Grid.Column="6" Content="X" ToolTip="Remove entry"
                                        Command="{Binding DataContext.RemoveDailyEntryCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="2" Padding="4,4"
                                        Background="{StaticResource DangerBrush}"
                                        FontSize="11" MinWidth="0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
