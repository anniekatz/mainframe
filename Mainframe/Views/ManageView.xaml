<UserControl x:Class="Mainframe.Views.ManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BgBase}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- charge codes -->
        <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                CornerRadius="6" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CHARGE CODES" FontSize="13"
                           FontWeight="Bold" Margin="0,0,0,12"
                           Foreground="{StaticResource TextSecondary}" FontFamily="Consolas"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="CODE" FontSize="11" Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,2" FontFamily="Consolas"/>
                    <TextBox Text="{Binding NewChargeCodeCode, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" Margin="0,0,0,6"/>

                    <TextBlock Text="DESCRIPTION" FontSize="11" Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,2" FontFamily="Consolas"/>
                    <TextBox Text="{Binding NewChargeCodeDescription, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Padding="8,6"
                                Command="{Binding AddChargeCodeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="ADD"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedManageChargeCode, Converter={StaticResource NullToBoolConverter}}" Value="False">
                                            <Setter Property="Content" Value="UPDATE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="REMOVE"
                                Command="{Binding RemoveChargeCodeCommand}"
                                Padding="8,6" Background="{StaticResource DangerBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- charge code list -->
                <ListBox ItemsSource="{Binding ChargeCodes}"
                         SelectedItem="{Binding SelectedManageChargeCode}"
                         Margin="0" Padding="4"
                         BorderThickness="1" BorderBrush="{StaticResource BorderSubtle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="2,2">
                                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{StaticResource AccentBrush}"/>
                                <Run Text=" - " Foreground="{StaticResource TextMuted}"/>
                                <Run Text="{Binding Description, Mode=OneWay}"
                                     Foreground="{StaticResource TextSecondary}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- projects -->
        <Border Grid.Column="2" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                CornerRadius="6" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="PROJECTS / TASKS / SUBTASKS"
                           FontSize="13" FontWeight="Bold" Margin="0,0,0,12"
                           Foreground="{StaticResource TextSecondary}" FontFamily="Consolas"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- projects -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="PROJECTS" FontWeight="SemiBold"
                                   FontSize="11" Margin="0,0,0,6"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Consolas"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="ADD"
                                        Command="{Binding AddProjectCommand}" Padding="6,4"/>
                                <Button Grid.Column="2" Content="DEL"
                                        Command="{Binding RemoveProjectCommand}"
                                        Padding="6,4" Background="{StaticResource DangerBrush}"/>
                            </Grid>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Projects}"
                                 SelectedItem="{Binding SelectedManageProject}"
                                 BorderThickness="1" BorderBrush="{StaticResource BorderSubtle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="2,2" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- project tasks -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="TASKS" FontWeight="SemiBold"
                                   FontSize="11" Margin="0,0,0,6"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Consolas"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBox Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="ADD"
                                        Command="{Binding AddTaskCommand}" Padding="6,4"/>
                                <Button Grid.Column="2" Content="DEL"
                                        Command="{Binding RemoveTaskCommand}"
                                        Padding="6,4" Background="{StaticResource DangerBrush}"/>
                            </Grid>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding ManageTasks}"
                                 SelectedItem="{Binding SelectedManageTask}"
                                 BorderThickness="1" BorderBrush="{StaticResource BorderSubtle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="2,2" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- task's subtasks -->
                    <DockPanel Grid.Column="4">
                        <TextBlock DockPanel.Dock="Top" Text="SUBTASKS" FontWeight="SemiBold"
                                   FontSize="11" Margin="0,0,0,6"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Consolas"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <TextBox Text="{Binding NewSubtaskName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="ADD"
                                        Command="{Binding AddSubtaskCommand}" Padding="6,4"/>
                                <Button Grid.Column="2" Content="DEL"
                                        Command="{Binding RemoveSubtaskCommand}"
                                        Padding="6,4" Background="{StaticResource DangerBrush}"/>
                            </Grid>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding ManageSubtasks}"
                                 SelectedItem="{Binding SelectedManageSubtask}"
                                 BorderThickness="1" BorderBrush="{StaticResource BorderSubtle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="2,2" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
